generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id                     Int      @id @default(1)
  storeNameAr            String   @default("كسيرات")
  storeNameEn            String   @default("Kseerat")
  logoUrl                String?
  primaryColor           String   @default("#B39A7B")
  announcementAr         String?
  storyTitleAr           String?
  storyQuoteAr           String?
  storySignatureAr       String?
  heritageFooterNote     String?
  trust1TitleAr          String?
  trust1DescAr           String?
  trust2TitleAr          String?
  trust2DescAr           String?
  trust3TitleAr          String?
  trust3DescAr           String?
  phone                  String?
  workingHoursAr         String?
  whatsapp               String?
  commercialRegistration String?
  taxNumber              String?
  instagram              String?
  twitter                String?
  snapchat               String?
  tiktok                 String?
  facebook               String?
  youtube                String?
  showPaymentIcons       Boolean  @default(true)
  loyaltyTitleAr         String?
  loyaltySubtitleAr      String?
  googleMapsApiKey       String?
  myfatoorahMode         String   @default("MOCK")
  myfatoorahApiKey       String?
  myfatoorahBaseUrl      String?
  vapidPublicKey         String?
  vapidPrivateKey        String?
  updatedAt              DateTime @updatedAt
}

model Currency {
  code                 String @id
  nameAr               String
  countryAr            String
  flag                 String
  symbolAr             String
  exchangeRateFromKwd  Float
  decimals             Int    @default(2)
  freeShippingThreshold Float @default(0)
  defaultShippingCost  Float  @default(0)
  estimatedDeliveryAr  String?
  sortOrder            Int    @default(0)
}

model HeroSlide {
  id            Int      @id @default(autoincrement())
  titleAr       String
  titleEn       String?
  subtitleAr    String?
  subtitleEn    String?
  buttonTextAr  String?
  buttonTextEn  String?
  buttonLink    String?
  imageUrl      String
  mobileImageUrl String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Category {
  id           Int       @id @default(autoincrement())
  nameAr       String
  nameEn       String?
  slug         String    @unique
  descriptionAr String?
  imageUrl     String?
  sortOrder    Int       @default(0)
  showInNavbar Boolean   @default(true)
  isActive     Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
}

model Product {
  id               String   @id @default(cuid())
  nameAr           String
  nameEn           String?
  slug             String   @unique
  sku              String   @unique
  shortDescAr      String?
  fullDescAr       String?
  categoryId       Int
  category         Category @relation(fields: [categoryId], references: [id])
  basePriceKwd     Float
  discountPriceKwd Float?
  currencyPricesJson String @default("{}")
  stock            Int      @default(0)
  lowStockThreshold Int     @default(5)
  weightGrams      Int?
  imagesJson       String   @default("[]")
  topNotesAr       String?
  heartNotesAr     String?
  baseNotesAr      String?
  fragranceFamilyAr String?
  longevity        Int      @default(3)
  sillage          Int      @default(3)
  gender           String   @default("للجنسين")
  season           String   @default("جميع الفصول")
  isBestSeller     Boolean  @default(false)
  isNewArrival     Boolean  @default(false)
  isSpecialOffer   Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  isActive         Boolean  @default(true)
  variants         ProductVariant[]
  orderItems       OrderItem[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([categoryId])
}

model ProductVariant {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameAr           String
  nameEn           String?
  sku              String?
  stock            Int     @default(0)
  priceKwd         Float
  discountPriceKwd Float?
  currencyPricesJson String @default("{}")
  isDefault        Boolean @default(false)

  @@index([productId])
}

model User {
  id              String   @id @default(cuid())
  firstName       String?
  lastName        String?
  email           String?  @unique
  phoneCountryCode String?
  phoneNumber     String?
  role            String   @default("CUSTOMER")
  googleId        String?
  loyaltyPoints   Int      @default(0)
  createdAt       DateTime @default(now())
  orders          Order[]
  sessions        Session[]
  otps            OtpVerification[]
  pushSubscriptions PushSubscription[]

  @@index([phoneNumber])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpVerification {
  id         String   @id @default(cuid())
  identifier String
  channel    String
  code       String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([identifier])
}

model ShippingCompany {
  id                    Int     @id @default(autoincrement())
  nameAr                String
  deliveryTimeAr        String?
  logoUrl               String?
  baseCostKwd           Float   @default(0)
  supportedCountriesJson String @default("[]")
  isActive              Boolean @default(true)
  orders                Order[]
}

model Coupon {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  discountType  String
  discountValue Float
  minOrderKwd   Float     @default(0)
  maxUses       Int       @default(0)
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model Order {
  id                   String   @id @default(cuid())
  orderNumber          String   @unique
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id])
  isGuest              Boolean  @default(false)
  customerFirstName    String
  customerLastName     String
  customerPhoneCode    String
  customerPhone        String
  customerEmail        String?
  country              String
  governorate          String
  cityArea             String
  blockStreet          String
  houseBuilding        String
  floorApartment       String?
  addressNotes         String?
  latitude             Float?
  longitude            Float?
  googleMapsUrl        String?
  formattedMapAddress  String?
  shippingCompanyId    Int?
  shippingCompany      ShippingCompany? @relation(fields: [shippingCompanyId], references: [id])
  shippingCompanyName  String?
  shippingCostKwd      Float    @default(0)
  currencyCode         String   @default("KWD")
  exchangeRateUsed     Float    @default(1)
  subtotalKwd          Float
  discountKwd          Float    @default(0)
  couponCode           String?
  totalKwd             Float
  totalInSelectedCurrency Float
  paymentMethod        String
  paymentStatus        String   @default("PENDING")
  myfatoorahInvoiceId  String?
  myfatoorahPaymentId  String?
  orderStatus          String   @default("NEW")
  items                OrderItem[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([orderStatus])
  @@index([userId])
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  variantId      String?
  nameAr         String
  variantNameAr  String?
  imageUrl       String?
  unitPriceKwd   Float
  quantity       Int
  totalPriceKwd  Float
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userRole  String   @default("CUSTOMER")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userRole])
}

model Notification {
  id         Int      @id @default(autoincrement())
  title      String
  body       String
  url        String?
  imageUrl   String?
  targetType String   @default("ALL")
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}
